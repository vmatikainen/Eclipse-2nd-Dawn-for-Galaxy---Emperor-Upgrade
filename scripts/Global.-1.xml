<!-- Button to re-open the Setup menu, initially INACTIVE -->
<Panel id="Button_ShowSetup"
	allowDragging="false"
    height="50"
    active = "false"
	visibility= ""
    offsetXY="250 0"
    raycastTarget="true"
    rectAlignment="UpperLeft"
    returnToOriginalPositionWhenReleased="false"
    showAnimation="FadeIn"
    showAnimationDelay="2"
    width="125">

    <!-- The button container. -->
    <VerticalLayout>
        <!-- The button to open the setup panel. -->
        <Button id="OpenSetupPanelButton" onClick="openSetupPanel">
          Setup Options
        </Button>
    </VerticalLayout>
</Panel>



<!-- Turn order panel, shown during the draft and faction selection -->
<Panel id="ATO_Panel"
	width="290"
	height="460"
	active="false"
	rectAlignment="UpperRight"
	offsetXY="-10 -120"
	allowDragging="true"
	returnToOriginalPositionWhenReleased="false"
	color="rgba(0.15, 0.15, 0.15, 0.92)"
	outline="Grey"
	outlineSize="2 -2">

	<Text text="Turn Order" fontSize="16" fontStyle="Bold" rectAlignment="UpperCenter" alignment="MiddleCenter" width="270" height="30" offsetXY="0 -5"></Text>
