    offsetXY="0 -160"
	visibility= "White|Red|Blue|Purple|Yellow|Green|Pink|Orange|Teal|Brown|Black|Grey"
    hideAnimation="FadeOut"
    animationDuration="0.5"
    allowDragging="true"
    returnToOriginalPositionWhenReleased="false"
    color="rgba(0.3, 0.3, 0.3, 0.95)"
    >


  	<!-- The top row containing the title and close button -->
	<Text text="Setup Options" Color="White" fontSize="18" fontStyle="Bold" rectAlignment="UpperCenter" alignment="LowerCenter" width="230" height="80" offsetXY="0 55"></Text>
	<Button id="closeButton" class="topButtons" rectAlignment="UpperRight" color="#990000" textColor="#FFFFFF" text="X" onClick="closeSetupPanel"></Button>


    <Panel offsetXY="0 -35" color="#000000" width="396" height="866" outline="Grey" outlineSize="2 -2">
		<!-- Background image (black behind it, if it is missing: see setupBackground_check) -->
		<Image id="SetupBackground" image="SetupOptions" preserveAspect="true" rectAlignment="UpperLeft"> </Image>

		<!-- All content displayed over the background image, below the title text at its top -->
		<VerticalLayout padding="10 10 270 30">

  			<!-- Expansions -->
			<VerticalLayout padding="10 10 10 0" preferredHeight="50"
    			childForceExpandHeight="false" spacing="5">

    			<Text class="Heading"> Expansions </Text>

				<HorizontalLayout flexibleHeight="0">
					<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="FirstEdition" isOn="true" onValueChanged="SetupUI_OnChange"
        				tooltip="Factions from expansions, including compatible ones from the 1st edition">
        			Expansion Species </Toggle>
			

    				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="MinorSpecies" isOn="true" onValueChanged="SetupUI_OnChange"
        				tooltip="Enable ambassadors from minor factions">
        			Minor Species </Toggle>

				</HorizontalLayout>


				<HorizontalLayout flexibleHeight="0">
    				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="RiftWeapons" isOn="true" onValueChanged="SetupUI_OnChange"
						tooltip="Add Rift Ship Parts, powerful weapons that can also backfire">
        			Rift Cannon </Toggle>

					<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="GalacticEvents" isOn="false" onValueChanged="SetupUI_OnChange"
        				tooltip="Add Pulsar, Super Nova, Black Hole and Nebula sectors">
        			Galactic Events </Toggle>
				</HorizontalLayout>
			</VerticalLayout>


			<!-- Options -->
			<VerticalLayout padding="10 10 10 0" preferredHeight="50"
    			childForceExpandHeight="false" spacing="5">

       		<Text class="Heading"> Options </Text>

			<HorizontalLayout flexibleHeight="0">
          		<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            		id="AdvancedGCDS" onValueChanged="SetupUI_OnChange"
              		tooltip="Randomly chose a blueprint for the Galactic Center, including advanced versions">
              	Randomize GCDS </Toggle>

            	<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            		id="AdvancedAncients" onValueChanged="SetupUI_OnChange"
              		tooltip="Randomly chose a blueprint for the Ancients, including advanced versions">
              	Randomize Ancients </Toggle>
			</HorizontalLayout>

			<HorizontalLayout flexibleHeight="0">
            <Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            	id="AdvancedGuardians" onValueChanged="SetupUI_OnChange"
              	tooltip="Randomly chose a blueprint for the Guardian ships, including advanced versions">
              Randomize Guardians </Toggle>

            <Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            	id="RandomRaces" onValueChanged="SetupUI_OnChange"
              	tooltip="Give every player a random faction instead of picking one. The Terran factions count as one faction, and Pyxis Unity is never drawn. Factions are given out in faction pick order. There is no draft: Draft as starting player works as Random.">
              Random factions </Toggle>
			</HorizontalLayout>
			<!-- separator: Randomize seat order and its timing dropdown belong together -->
			<HorizontalLayout minHeight="1" preferredHeight="1" flexibleHeight="0" childForceExpandWidth="false" childAlignment="MiddleCenter" padding="0 20 0 0">
				<Panel preferredWidth="300" flexibleWidth="0" color="rgba(1,1,1,0.4)"></Panel>
			</HorizontalLayout>
			<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
			<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
				id="RandomizeSeats" onValueChanged="SetupUI_OnChange"
				tooltip="Move the players to random seats by changing their player colors. The dropdown next to it sets when: before drafting (needs Draft as starting player; without it, the same as before faction selection), before faction selection, or after faction selection.">
			Randomize seat order </Toggle>

			<Dropdown id="SeatTiming" minWidth="140" preferredWidth="140" flexibleWidth="0"
				minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
				interactable="false" onValueChanged="SEAT_setTiming">
				<Option>Before drafting</Option>
				<Option>Before faction selection</Option>
				<Option selected="true">After faction selection</Option>
			</Dropdown>
			</HorizontalLayout>
       </VerticalLayout>


		<!-- Turn Order (tooltips are on the labels: a dropdown's tooltip can stick to the screen) -->
		<VerticalLayout padding="10 10 10 0" preferredHeight="50"
				 childForceExpandHeight="false"
				 spacing="5">

				<Text class="Heading"> Turn Order </Text>

				<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
				<Text minWidth="200" preferredWidth="200" flexibleWidth="0" minHeight="30" preferredHeight="30" flexibleHeight="0"
					tooltipBackgroundColor="rgba(0,0,0,0.95)"
					tooltip="Rotating: play goes clockwise from the starting player, as in the base game. The first player to pass starts the next round, and the second player to pass chooses the direction of play with the Direction of Play card.&#10;&#10;Pass order: each round is played in the order the players passed in the round before. Pass by flipping your Actions card face down during your turn.">
				Turn order </Text>

				<Dropdown id="TurnOrder" minWidth="140" preferredWidth="140" flexibleWidth="0"
					minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
					onValueChanged="ATO_setTurnOrder">
					<Option selected="true">Rotating</Option>
					<Option>Pass order</Option>
				</Dropdown>
				</HorizontalLayout>

				<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
				<Text minWidth="200" preferredWidth="200" flexibleWidth="0" minHeight="30" preferredHeight="30" flexibleHeight="0"
					tooltipBackgroundColor="rgba(0,0,0,0.95)"
					tooltip="Who starts round 1. Factions are then picked one player at a time, in reverse turn order.&#10;&#10;Yellow: the Yellow player (or the next seated player after Yellow).&#10;Random: a random player. With the pass order, the whole round 1 turn order is random.&#10;Draft, with Rotating: a random player chooses to be the starting player (and pick a faction last) or to pick a faction first (and the next player clockwise starts).&#10;Draft, with Pass order: in a random draft order, each player takes either the best faction pick position or the best turn order position, and gets the last free position of the other.&#10;With Random factions, Draft works as Random.">
				Starting player </Text>

				<Dropdown id="StartingPlayer" minWidth="140" preferredWidth="140" flexibleWidth="0"
					minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
					onValueChanged="ATO_setStartingPlayer">
					<Option selected="true">Yellow</Option>
					<Option>Random</Option>
					<Option>Draft</Option>
				</Dropdown>
				</HorizontalLayout>
		</VerticalLayout>


		<!-- House Rules -->
		<VerticalLayout padding="10 10 10 0" preferredHeight="50"
				 childForceExpandHeight="false"
				 spacing="5">

				<Text class="Heading"> House Rules </Text>

				<HorizontalLayout flexibleHeight="0">
				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
					id="NoRoundLimit" onValueChanged="SetupUI_OnChange"
					tooltip="Enable custom game modes that take more than 8 rounds">
				No Round Limit </Toggle>

				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
					id="TechAfterRaces" onValueChanged="SetupUI_OnChange"
					tooltip="Draw the starting technologies once every player has selected a faction, instead of when Setup is pressed. Works with every turn order and starting player.">
				Tech setup after faction selection </Toggle>
				</HorizontalLayout>

				<HorizontalLayout flexibleHeight="0">
				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
					id="CombatSim" onValueChanged="SetupUI_OnChange" isOn="true"
					tooltip="A Combat Sim button on every player board: simulates battles of your ships against the NPCs or another player, and shows the odds of winning.">
				Combat Simulator </Toggle>
				</HorizontalLayout>
		</VerticalLayout>


		<!-- Player Count -->
		<VerticalLayout padding="10 10 0 0"
			childForceExpandHeight="true" spacing="0">

			<Text class="Heading"> Player Count </Text>
			<ToggleGroup>
    			<HorizontalLayout spacing="12">
        			<ToggleButton id="2Players" onValueChanged="SetupUI_OnChange">2</ToggleButton>
        			<ToggleButton id="3Players" onValueChanged="SetupUI_OnChange">3</ToggleButton>
					<ToggleButton id="4Players" onValueChanged="SetupUI_OnChange" isOn="true">4</ToggleButton>
					<ToggleButton id="5Players" onValueChanged="SetupUI_OnChange">5</ToggleButton>
					<ToggleButton id="6Players" onValueChanged="SetupUI_OnChange">6</ToggleButton>
    			</HorizontalLayout>
			</ToggleGroup>
		</VerticalLayout>

		<!-- Setup Button -->
		<HorizontalLayout padding="10 10 20 0">
			<Button id="setupButton" class="topButtons" rectAlignment="LowerCenter" text="Setup" onClick="gameSetup"></Button>
		</HorizontalLayout>

		</VerticalLayout>
	</Panel>

</Panel>


<!-- Copy of the setup popup that flies to the Setup Options button when the popup is closed with X (scripts/include/SetupClose.ttslua) -->
<Panel id="SetupClose_Ghost"
	active="false"
	rectAlignment="UpperCenter"
	offsetXY="0 -160"
	width="400"
	height="872"
	raycastTarget="false"
	color="rgba(0.3, 0.3, 0.3, 0.95)"
	outline="Grey"
	outlineSize="2 -2">
	<Image id="SetupClose_Image" image="SetupOptions" preserveAspect="true" rectAlignment="UpperCenter" raycastTarget="false"></Image>
</Panel>