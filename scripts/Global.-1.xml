<Defaults>
	<Text fontSize="14" color="White" alignment="MiddleLeft"/>
	<Toggle isOn="false" fontSize="14" textcolor="White" color="White" interactable="true" rectAlignment="MiddleLeft" offsetXY="5 0" height="30" tooltipBackgroundColor="rgba(0,0,0,0.95)"/>
	<Button fontSize="14" textColor="Black" fontStyle="Bold" tooltipBackgroundColor="clear" shadow="Black" shadowDistance="1 -1"/>
	<ToggleButton fontSize="14" textColor="Black" fontStyle="Bold" shadow="Black" shadowDistance="0 0"  colors="White|#d0d0d0|#7E7E7E|#000000" tooltipBackgroundColor="clear"/>

	<Row class="LevelData" preferredHeight="0"/>
	<Text class="Heading" fontSize="16" color="White" alignment="MiddleLeft" fontStyle="Bold"/>
	<Button class="topButtons" width="25" height="25" rectAlignment="UpperLeft" color="#eeeeee" offsetXY="-3 -3"/>
</Defaults>



<!-- Button to re-open the Setup menu, initially INACTIVE -->
<Panel id="Button_ShowSetup"
	allowDragging="false"
    height="50"
    active = "false"
	visibility= ""
    offsetXY="250 0"
    raycastTarget="true"
    rectAlignment="UpperLeft"
    returnToOriginalPositionWhenReleased="false"
    showAnimation="FadeIn"
    showAnimationDelay="2"
    width="125">

    <!-- The button container. -->
    <VerticalLayout>
        <!-- The button to open the setup panel. -->
        <Button id="OpenSetupPanelButton" onClick="openSetupPanel">
          Setup Options
        </Button>
    </VerticalLayout>
</Panel>



<!-- Turn order panel, shown during the draft and faction selection -->
<Panel id="ATO_Panel"
	width="290"
	height="460"
	active="false"
	rectAlignment="UpperRight"
	offsetXY="-10 -120"
	allowDragging="true"
	returnToOriginalPositionWhenReleased="false"
	color="rgba(0.15, 0.15, 0.15, 0.92)"
	outline="Grey"
	outlineSize="2 -2">

	<Text text="Turn Order" fontSize="16" fontStyle="Bold" rectAlignment="UpperCenter" alignment="MiddleCenter" width="270" height="30" offsetXY="0 -5"></Text>
	<Text id="ATO_Text" fontSize="13" rectAlignment="UpperLeft" alignment="UpperLeft" width="266" height="330" offsetXY="12 -40"></Text>

	<VerticalLayout id="ATO_Buttons" active="false" rectAlignment="LowerCenter" width="266" height="76" offsetXY="0 10" spacing="6">
		<Button id="ATO_RaceButton" onClick="ATO_ChooseRace" color="#cfe3ff">Best faction pick</Button>
		<Button id="ATO_TurnButton" onClick="ATO_ChooseTurn" color="#ffe3b8">Best turn order</Button>
	</VerticalLayout>
</Panel>

<!-- Next round's order (pass order) or who passed (rotating) during play; top edge of the screen, one panel width from the right edge -->
<Panel id="ATO_NextPanel"
	width="220"
	height="140"
	active="false"
	rectAlignment="UpperRight"
	offsetXY="-180 0"
	allowDragging="true"
	returnToOriginalPositionWhenReleased="false"
	color="rgba(0.15, 0.15, 0.15, 0.8)">

	<Text id="ATO_NextText" fontSize="13" rectAlignment="UpperLeft" alignment="UpperLeft" width="204" height="130" offsetXY="8 -5"></Text>
</Panel>



<!-- Combat simulator, opened with the "Combat Sim" button on a player board (scripts/include/CombatSim.ttslua) -->
<Panel id="CombatSim_Panel"
	width="420"
	height="540"
	active="false"
	rectAlignment="MiddleCenter"
	offsetXY="0 0"
	allowDragging="true"
	returnToOriginalPositionWhenReleased="false"
	color="rgba(0.15, 0.15, 0.15, 0.95)"
	outline="Grey"
	outlineSize="2 -2">

	<Text text="Combat Sim" fontSize="16" fontStyle="Bold" rectAlignment="UpperCenter" alignment="MiddleCenter" width="300" height="30" offsetXY="0 -5"></Text>
	<Button class="topButtons" rectAlignment="UpperRight" color="#990000" textColor="#FFFFFF" text="X" onClick="CombatSim_close"></Button>
	<Text id="CombatSim_Owner" fontSize="13" rectAlignment="UpperLeft" alignment="MiddleLeft" width="270" height="20" offsetXY="10 -35"></Text>
	<HorizontalLayout rectAlignment="UpperRight" width="130" height="22" offsetXY="-10 -34" spacing="4">
		<Text fontSize="12" alignment="MiddleRight">Battles</Text>
		<Button id="CombatSim_Runs1000" fontSize="12" onClick="CombatSim_setRuns(1000)">1k</Button>
		<Button id="CombatSim_Runs5000" fontSize="12" onClick="CombatSim_setRuns(5000)">5k</Button>
	</HorizontalLayout>

	<!-- hidden elements take no space: CombatSim_updateUI sets the panel height -->
	<VerticalLayout rectAlignment="UpperLeft" width="400" height="632" offsetXY="10 -58" spacing="6" childAlignment="UpperLeft" childForceExpandHeight="false">
		<VerticalLayout preferredHeight="196" flexibleHeight="0" spacing="4" childForceExpandHeight="false">
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_interceptor_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Interceptors</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(interceptor)">-</Button>
				<Text id="CombatSim_interceptor_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(interceptor)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_interceptor_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_cruiser_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Cruisers</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(cruiser)">-</Button>
				<Text id="CombatSim_cruiser_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(cruiser)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_cruiser_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_dreadnought_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Dreadnoughts</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(dreadnought)">-</Button>
				<Text id="CombatSim_dreadnought_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(dreadnought)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_dreadnought_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_starbase_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Starbases</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(starbase)">-</Button>
				<Text id="CombatSim_starbase_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(starbase)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_starbase_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
		</VerticalLayout>

		<HorizontalLayout preferredHeight="26" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
			<Text preferredWidth="80" flexibleWidth="0" fontSize="14">You are</Text>
			<Button id="CombatSim_Attack" preferredWidth="100" flexibleWidth="0" fontSize="13" onClick="CombatSim_setRole(attack)">Attacking</Button>
			<Button id="CombatSim_Defend" preferredWidth="100" flexibleWidth="0" fontSize="13" onClick="CombatSim_setRole(defend)">Defending</Button>
		</HorizontalLayout>

		<!-- the dropdown: a button that opens CombatSim_List -->
		<HorizontalLayout preferredHeight="30" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
			<Text preferredWidth="80" flexibleWidth="0" fontSize="14">Opponent</Text>
			<Button id="CombatSim_Opponent" preferredWidth="220" flexibleWidth="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_toggleList">Ancients</Button>
			<Button id="CombatSim_Simulate" active="false" preferredWidth="88" flexibleWidth="0" fontSize="14" fontStyle="Bold" color="#cfe3ff" onClick="CombatSim_simulatePlayer">Simulate</Button>
		</HorizontalLayout>

		<HorizontalLayout id="CombatSim_NpcButtons" preferredHeight="32" flexibleHeight="0" spacing="6">
			<Button fontSize="13" onClick="CombatSim_simulate(ancient)">Ancient</Button>
			<Button fontSize="13" onClick="CombatSim_simulate(ancient2)">2 Ancients</Button>
			<Button fontSize="13" onClick="CombatSim_simulate(gcds)">GCDS</Button>
			<Button id="CombatSim_Guardian" fontSize="13" onClick="CombatSim_simulate(guardian)">Guardian</Button>
		</HorizontalLayout>

		<VerticalLayout id="CombatSim_OppShips" active="false" preferredHeight="196" flexibleHeight="0" spacing="4" childForceExpandHeight="false">
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_opp_interceptor_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Interceptors</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(opp_interceptor)">-</Button>
				<Text id="CombatSim_opp_interceptor_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(opp_interceptor)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_opp_interceptor_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_opp_cruiser_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Cruisers</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(opp_cruiser)">-</Button>
				<Text id="CombatSim_opp_cruiser_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(opp_cruiser)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_opp_cruiser_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_opp_dreadnought_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Dreadnoughts</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(opp_dreadnought)">-</Button>
				<Text id="CombatSim_opp_dreadnought_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(opp_dreadnought)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_opp_dreadnought_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
			<HorizontalLayout preferredHeight="24" flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="true" spacing="6">
				<Text id="CombatSim_opp_starbase_Label" preferredWidth="110" flexibleWidth="0" fontSize="14">Starbases</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_minus(opp_starbase)">-</Button>
				<Text id="CombatSim_opp_starbase_Count" preferredWidth="28" flexibleWidth="0" alignment="MiddleCenter" fontSize="14">0</Text>
				<Button preferredWidth="28" flexibleWidth="0" onClick="CombatSim_plus(opp_starbase)">+</Button>
			</HorizontalLayout>
			<Text id="CombatSim_opp_starbase_Info" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#cccccc"></Text>
		</VerticalLayout>

		<Text id="CombatSim_Result" preferredHeight="160" flexibleHeight="0" fontSize="12" alignment="UpperLeft"></Text>
	</VerticalLayout>

	<!-- the dropdown's options, under the Opponent button; last, so it is drawn on top -->
	<Panel id="CombatSim_List" active="false" rectAlignment="UpperLeft" pivot="0 1" width="220" height="200" offsetXY="96 -322" color="#222222" outline="Grey" outlineSize="1 -1">
		<VerticalLayout padding="2 2 2 2" spacing="2" childForceExpandHeight="false">
			<Button id="CombatSim_Option0" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(0)">Ancients</Button>
			<Button id="CombatSim_Option1" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(1)"></Button>
			<Button id="CombatSim_Option2" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(2)"></Button>
			<Button id="CombatSim_Option3" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(3)"></Button>
			<Button id="CombatSim_Option4" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(4)"></Button>
			<Button id="CombatSim_Option5" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(5)"></Button>
			<Button id="CombatSim_Option6" active="false" preferredHeight="26" flexibleHeight="0" fontSize="13" color="#444444" textColor="#FFFFFF" textAlignment="MiddleLeft" onClick="CombatSim_pick(6)"></Button>
		</VerticalLayout>
	</Panel>
</Panel>



<Panel id="SetupPanel"
	width="400"
    height="872"
	active = "false"
    rectAlignment="UpperCenter"
    offsetXY="0 -160"
	visibility= "White|Red|Blue|Purple|Yellow|Green|Pink|Orange|Teal|Brown|Black|Grey"
    hideAnimation="FadeOut"
    animationDuration="0.5"
    allowDragging="true"
    returnToOriginalPositionWhenReleased="false"
    color="rgba(0.3, 0.3, 0.3, 0.95)"
    >


  	<!-- The top row containing the title and close button -->
	<Text text="Setup Options" Color="White" fontSize="18" fontStyle="Bold" rectAlignment="UpperCenter" alignment="LowerCenter" width="230" height="80" offsetXY="0 55"></Text>
	<Button id="closeButton" class="topButtons" rectAlignment="UpperRight" color="#990000" textColor="#FFFFFF" text="X" onClick="closeSetupPanel"></Button>


    <Panel offsetXY="0 -35" color="rgb(0.5, 0.5, 0.5)" width="396" height="866" outline="Grey" outlineSize="2 -2">
		<!-- Background image-->
		<Image image="SetupOptions" preserveAspect="true" rectAlignment="UpperLeft"> </Image>

		<!-- All content displayed over the background image, below the title text at its top -->
		<VerticalLayout padding="10 10 270 30">

  			<!-- Expansions -->
			<VerticalLayout padding="10 10 10 0" preferredHeight="50"
    			childForceExpandHeight="false" spacing="5">

    			<Text class="Heading"> Expansions </Text>

				<HorizontalLayout flexibleHeight="0">
					<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="FirstEdition" isOn="true" onValueChanged="SetupUI_OnChange"
        				tooltip="Factions from expansions, including compatible ones from the 1st edition">
        			Expansion Species </Toggle>
			

    				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="MinorSpecies" isOn="true" onValueChanged="SetupUI_OnChange"
        				tooltip="Enable ambassadors from minor factions">
        			Minor Species </Toggle>

				</HorizontalLayout>


				<HorizontalLayout flexibleHeight="0">
    				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="RiftWeapons" isOn="true" onValueChanged="SetupUI_OnChange"
						tooltip="Add Rift Ship Parts, powerful weapons that can also backfire">
        			Rift Cannon </Toggle>

					<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
        				id="GalacticEvents" isOn="false" onValueChanged="SetupUI_OnChange"
        				tooltip="Add Pulsar, Super Nova, Black Hole and Nebula sectors">
        			Galactic Events </Toggle>
				</HorizontalLayout>
			</VerticalLayout>


			<!-- Options -->
			<VerticalLayout padding="10 10 10 0" preferredHeight="50"
    			childForceExpandHeight="false" spacing="5">

       		<Text class="Heading"> Options </Text>

			<HorizontalLayout flexibleHeight="0">
          		<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            		id="AdvancedGCDS" onValueChanged="SetupUI_OnChange"
              		tooltip="Randomly chose a blueprint for the Galactic Center, including advanced versions">
              	Randomize GCDS </Toggle>

            	<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            		id="AdvancedAncients" onValueChanged="SetupUI_OnChange"
              		tooltip="Randomly chose a blueprint for the Ancients, including advanced versions">
              	Randomize Ancients </Toggle>
			</HorizontalLayout>

			<HorizontalLayout flexibleHeight="0">
            <Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            	id="AdvancedGuardians" onValueChanged="SetupUI_OnChange"
              	tooltip="Randomly chose a blueprint for the Guardian ships, including advanced versions">
              Randomize Guardians </Toggle>

            <Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
            	id="RandomRaces" onValueChanged="SetupUI_OnChange"
              	tooltip="Give every player a random faction instead of picking one. The Terran factions count as one faction, and Pyxis Unity is never drawn. Factions are given out in faction pick order. There is no draft: Draft as starting player works as Random.">
              Random factions </Toggle>
			</HorizontalLayout>
			<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
			<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
				id="RandomizeSeats" onValueChanged="SetupUI_OnChange"
				tooltip="Move the players to random seats by changing their player colors. The dropdown next to it sets when: before drafting (needs Draft as starting player; without it, the same as before faction selection), before faction selection, or after faction selection.">
			Randomize seat order </Toggle>

			<Dropdown id="SeatTiming" minWidth="140" preferredWidth="140" flexibleWidth="0"
				minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
				interactable="false" onValueChanged="SEAT_setTiming">
				<Option>Before drafting</Option>
				<Option>Before faction selection</Option>
				<Option selected="true">After faction selection</Option>
			</Dropdown>
			</HorizontalLayout>
       </VerticalLayout>


		<!-- Turn Order (tooltips are on the labels: a dropdown's tooltip can stick to the screen) -->
		<VerticalLayout padding="10 10 10 0" preferredHeight="50"
				 childForceExpandHeight="false"
				 spacing="5">

				<Text class="Heading"> Turn Order </Text>

				<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
				<Text minWidth="200" preferredWidth="200" flexibleWidth="0" minHeight="30" preferredHeight="30" flexibleHeight="0"
					tooltipBackgroundColor="rgba(0,0,0,0.95)"
					tooltip="Rotating: play goes clockwise from the starting player, as in the base game. The first player to pass starts the next round, and the second player to pass chooses the direction of play with the Direction of Play card.&#10;&#10;Pass order: each round is played in the order the players passed in the round before. Pass by flipping your Actions card face down during your turn.">
				Turn order </Text>

				<Dropdown id="TurnOrder" minWidth="140" preferredWidth="140" flexibleWidth="0"
					minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
					onValueChanged="ATO_setTurnOrder">
					<Option selected="true">Rotating</Option>
					<Option>Pass order</Option>
				</Dropdown>
				</HorizontalLayout>

				<HorizontalLayout flexibleHeight="0" childForceExpandWidth="false" childForceExpandHeight="false" spacing="0">
				<Text minWidth="200" preferredWidth="200" flexibleWidth="0" minHeight="30" preferredHeight="30" flexibleHeight="0"
					tooltipBackgroundColor="rgba(0,0,0,0.95)"
					tooltip="Who starts round 1. Factions are then picked one player at a time, in reverse turn order.&#10;&#10;Yellow: the Yellow player (or the next seated player after Yellow).&#10;Random: a random player. With the pass order, the whole round 1 turn order is random.&#10;Draft (pass order only): in a random draft order, each player takes either the best faction pick position or the best turn order position, and gets the last free position of the other. With Rotating or Random factions it works as Random.">
				Starting player </Text>

				<Dropdown id="StartingPlayer" minWidth="140" preferredWidth="140" flexibleWidth="0"
					minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="12" textColor="#000000" itemTextColor="#000000"
					onValueChanged="ATO_setStartingPlayer">
					<Option selected="true">Yellow</Option>
					<Option>Random</Option>
					<Option>Draft</Option>
				</Dropdown>
				</HorizontalLayout>
		</VerticalLayout>


		<!-- House Rules -->
		<VerticalLayout padding="10 10 10 0" preferredHeight="50"
				 childForceExpandHeight="false"
				 spacing="5">

				<Text class="Heading"> House Rules </Text>

				<HorizontalLayout flexibleHeight="0">
				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
					id="NoRoundLimit" onValueChanged="SetupUI_OnChange"
					tooltip="Enable custom game modes that take more than 8 rounds">
				No Round Limit </Toggle>

				<Toggle minWidth="200" preferredWidth="200" flexibleWidth="0" flexibleHeight="0"
					id="TechAfterRaces" onValueChanged="SetupUI_OnChange"
					tooltip="Draw the starting technologies once every player has selected a faction, instead of when Setup is pressed. Works with every turn order and starting player.">
				Tech setup after faction selection </Toggle>
				</HorizontalLayout>
		</VerticalLayout>


		<!-- Player Count -->
		<VerticalLayout padding="10 10 0 0"
			childForceExpandHeight="true" spacing="0">

			<Text class="Heading"> Player Count </Text>
			<ToggleGroup>
    			<HorizontalLayout spacing="12">
        			<ToggleButton id="2Players" onValueChanged="SetupUI_OnChange">2</ToggleButton>
        			<ToggleButton id="3Players" onValueChanged="SetupUI_OnChange">3</ToggleButton>
					<ToggleButton id="4Players" onValueChanged="SetupUI_OnChange" isOn="true">4</ToggleButton>
					<ToggleButton id="5Players" onValueChanged="SetupUI_OnChange">5</ToggleButton>
					<ToggleButton id="6Players" onValueChanged="SetupUI_OnChange">6</ToggleButton>
    			</HorizontalLayout>
			</ToggleGroup>
		</VerticalLayout>

		<!-- Setup Button -->
		<HorizontalLayout padding="10 10 20 0">
			<Button id="setupButton" class="topButtons" rectAlignment="LowerCenter" text="Setup" onClick="gameSetup"></Button>
		</HorizontalLayout>

		</VerticalLayout>
	</Panel>

</Panel>