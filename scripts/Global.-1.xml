	<VerticalLayout id="ATO_Buttons" active="false" rectAlignment="LowerCenter" width="266" height="76" offsetXY="0 10" spacing="6">
		<Button id="ATO_RaceButton" onClick="ATO_ChooseRace" color="#cfe3ff">Best faction pick</Button>
		<Button id="ATO_TurnButton" onClick="ATO_ChooseTurn" color="#ffe3b8">Best turn order</Button>
	</VerticalLayout>
</Panel>

<!-- Next round's order (pass order) or who passed (rotating) during play; top edge of the screen, one panel width from the right edge -->
