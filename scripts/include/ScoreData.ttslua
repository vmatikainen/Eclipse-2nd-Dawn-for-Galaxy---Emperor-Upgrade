-- sector tiles whose Description has no number: Description -> sector number printed on the tile
SECTOR_NUMBER_BY_DESCRIPTION = {
  ["Enlightened of Lyra"] = 238,
}

-- Discovery tiles that aren't ship parts (DISCOVERY_PARTS has those), by texture. Every
-- Discovery tile has the same back, worth 2 VP when kept (DISCOVERY_KEPT_VP): that is the side
-- face down in TTS (rotation x 180). Types that score with their front up:
--   artifact_codex     1 VP per artifact in the sectors the holder controls
--   ancient_might      1 VP per 3 VP of the holder's Reputation tiles (hidden)
--   ancient_warp_portal  placed in a sector: 2 VP to the player who controls it
DISCOVERY_KEPT_VP = 2
DISCOVERY_TILES = {
  ["https://steamusercontent-a.akamaihd.net/ugc/1267149075135697858/DB4B52C012F98475AC1A7AB4849ADFCAFE0CF4CD/"] = { type = "artifact_codex", name = "Artifact Codex" },
