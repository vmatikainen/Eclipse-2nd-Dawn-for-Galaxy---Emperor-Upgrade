-- techs on one track -> VP, as printed on every board's tech tracks (and the rules reference)
TECH_TRACK_VP = { [4] = 1, [5] = 2, [6] = 3, [7] = 5 }

-- Minor Species ambassadors ("Minor Ambassador - <name>"), from their descriptions: 1 VP each,
-- except these. "per_ambassador": 1 VP per Ambassador tile on the board (itself included);
-- "per_reputation": 1 VP per Reputation tile on the board.
MINOR_AMBASSADOR_VP = {
  Wealth = 3,
  Diplomacy = "per_ambassador",
  Reputation = "per_reputation",
}

SCORE_TRAITOR_VP = -2
SCORE_MONOLITH_VP = 3
SCORE_WARP_PORTAL_VP = 1   -- the Warp Portal tile of the rare tech
