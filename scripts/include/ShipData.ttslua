--------------------------------------------------------------------------------
-- Ship data: what every ship part does, and each race's printed ship blueprints.
-- Reference data only; ShipState copies a race's blueprints to the player who picks it.
--
-- Read from the part tiles, Discovery tiles and player board images in the mod.
--------------------------------------------------------------------------------

-- Part stats. energy: + produced, - used. shield is the size of the shield (a printed
-- "-1" box is shield = 1). Dice: count dice of a colour, each doing `damage` on a hit.
-- Missiles fire once, before cannons. Rift dice (pink) have their own damage rules.
SHIP_PARTS = {
  -- cannons
  ["Ion Cannon"]        = { energy = -1, cannons  = { { color = "yellow", count = 1, damage = 1 } } },
  ["Plasma Cannon"]     = { energy = -2, cannons  = { { color = "orange", count = 1, damage = 2 } } },
  ["Soliton Cannon"]    = { energy = -3, cannons  = { { color = "blue",   count = 1, damage = 3 } } },
  ["Antimatter Cannon"] = { energy = -4, cannons  = { { color = "red",    count = 1, damage = 4 } } },
  ["Rift Cannon"]       = { energy = -2, cannons  = { { color = "pink",   count = 1, rift = true } } },
  ["Orbital Ion Turret"] = { energy = -1, cannons = { { color = "yellow", count = 2, damage = 1 } } },  -- printed on the Exiles Orbital
  -- missiles
  ["Flux Missile"]      = { initiative = 1, missiles = { { color = "yellow", count = 2, damage = 1 } } },
  ["Plasma Missile"]    = { energy = -1,    missiles = { { color = "orange", count = 2, damage = 2 } } },
  -- computers
  ["Electron Computer"] = { computer = 1 },
  ["Positron Computer"] = { computer = 2, energy = -1 },
  ["Gluon Computer"]    = { computer = 3, energy = -2 },
  -- hulls
  ["Hull"]              = { hull = 1 },
  ["Improved Hull"]     = { hull = 2 },
  ["Conifold Field"]    = { hull = 3, energy = -2 },
  ["Sentient Hull"]     = { hull = 1, computer = 1 },
  -- shields
  ["Gauss Shield"]      = { shield = 1 },
  ["Phase Shield"]      = { shield = 2, energy = -1 },
  ["Absorption Shield"] = { shield = 1, energy = 4 },
  -- drives
  ["Nuclear Drive"]     = { movement = 1, initiative = 1, energy = -1 },
  ["Fusion Drive"]      = { movement = 2, initiative = 2, energy = -2 },
  ["Tachyon Drive"]     = { movement = 3, initiative = 3, energy = -3 },
  ["Transition Drive"]  = { movement = 3 },
  -- energy sources
  ["Nuclear Source"]    = { energy = 3 },
  ["Fusion Source"]     = { energy = 6 },
  ["Tachyon Source"]    = { energy = 9 },
  ["Zero-Point Source"] = { energy = 12 },

  -- ancient technology: Discovery tiles (ancient = true). Muon Source goes on the Muon
  -- Source spot outside the blueprint; the others go in normal slots.
  ["Muon Source"]        = { ancient = true, energy = 2, initiative = 1 },
  ["Ion Disruptor"]      = { ancient = true, initiative = 3, cannons = { { color = "yellow", count = 1, damage = 1 } } },
  ["Ion Turret"]         = { ancient = true, cannons = { { color = "yellow", count = 2, damage = 1 } } },
  ["Plasma Turret"]      = { ancient = true, energy = -3, cannons = { { color = "orange", count = 2, damage = 2 } } },
  ["Soliton Charger"]    = { ancient = true, energy = -1, cannons = { { color = "blue", count = 1, damage = 3 } } },
  ["Rift Conductor"]     = { ancient = true, energy = -1, hull = 1, cannons = { { color = "pink", count = 1, rift = true } } },
  ["Ion Missile"]        = { ancient = true, missiles = { { color = "yellow", count = 3, damage = 1 } } },
  ["Soliton Missile"]    = { ancient = true, initiative = 1, missiles = { { color = "blue", count = 1, damage = 3 } } },
  ["Antimatter Missile"] = { ancient = true, missiles = { { color = "red", count = 1, damage = 4 } } },
  ["Axion Computer"]     = { ancient = true, initiative = 1, computer = 2 },
  ["Shard Hull"]         = { ancient = true, hull = 3 },
  ["Inversion Shield"]   = { ancient = true, shield = 2, energy = 2 },
  ["Flux Shield"]        = { ancient = true, initiative = 1, shield = 3, energy = -2 },
  ["Morph Shield"]       = { ancient = true, initiative = 1, shield = 1, regenerate = true },  -- repairs damage
  ["Nonlinear Drive"]    = { ancient = true, movement = 2, energy = 2 },
  ["Conformal Drive"]    = { ancient = true, movement = 4, initiative = 2, energy = -2 },
  ["Jump Drive"]         = { ancient = true, jump = true, energy = -2 },  -- moves by jumping (own rules)
  ["Hypergrid Source"]   = { ancient = true, energy = 11 },
}

