-- Ships and their snap point ranges on a player board (see CLAUDE.md, "Snap point convention").
SHIP_TYPES = { "interceptor", "cruiser", "dreadnought", "starbase" }
SHIP_SNAPS = {
  interceptor = { first = 7,  cells = 4, muon = 11 },
  cruiser     = { first = 12, cells = 6, muon = 18 },
  dreadnought = { first = 19, cells = 8, muon = 27 },
  starbase    = { first = 28, cells = 5, muon = 33 },
}

-- In a blueprint's cells: false = an empty slot, NO_SLOT = the race has no slot there.
NO_SLOT = "NO_SLOT"

-- Cells in snap point order: column by column, top to bottom, as printed on a standard board.
--   interceptor: left, middle top, middle bottom, right
--   cruiser:     left top, left bottom, middle top, middle bottom, right top, right bottom
--   dreadnought: four columns of two
--   starbase:    left top, left bottom, middle, right top, right bottom
-- base: printed values outside the slots (initiative chevrons, energy, bonus boxes).
local STANDARD = {
  interceptor = { name = "Interceptor", base = { initiative = 2 },
                  cells = { "Nuclear Source", "Ion Cannon", "Nuclear Drive", false } },
  cruiser     = { name = "Cruiser", base = { initiative = 1 },
                  cells = { "Electron Computer", "Nuclear Source", "Ion Cannon", "Hull", false, "Nuclear Drive" } },
  dreadnought = { name = "Dreadnought", base = {},
                  cells = { "Electron Computer", "Nuclear Source", "Ion Cannon", "Hull",
                            "Ion Cannon", "Hull", false, "Nuclear Drive" } },
  starbase    = { name = "Starbase", base = { initiative = 4, energy = 3 },
                  cells = { "Electron Computer", "Hull", false, "Ion Cannon", "Hull" } },
}

