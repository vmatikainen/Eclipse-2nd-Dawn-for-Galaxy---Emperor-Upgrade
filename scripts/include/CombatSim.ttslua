--------------------------------------------------------------------------------
-- Combat simulator
--------------------------------------------------------------------------------
-- Every player board gets a "Combat Sim" button (between the Actions card and the
-- Interceptor blueprint). It opens a panel (CombatSim_Panel in Global.-1.xml) where you
-- set how many interceptors, cruisers, dreadnoughts and starbases you have, whether you
-- attack or defend, and the opponent: "Ancients" or another player, from a dropdown.
-- With Ancients, the Ancient / 2 Ancients / GCDS / Guardian buttons simulate at once; with
-- a player, you set their ships too and press Simulate. Each simulation is 1000 or 5000
-- Monte Carlo battles. It shows the odds of winning and, when winning, how many ships
-- survive on average (for another player, theirs too).
--
-- The dropdown is a button and a list of option buttons (CombatSim_List): a TTS Dropdown's
-- options can't be changed by a script, and the list of players is only known in game.
--
-- Player ships are their blueprints now (ShipState_stats). The NPCs are the variants
-- setup put on the table (ShipState_npcOf), so randomized Ancients, Guardians and GCDS
-- are simulated as they are in this game.
--
-- Rules simulated:
--  - Missiles fire first, once, in initiative order; then engagement rounds of cannons in
--    initiative order until one side is gone. On a tie the defender fires first. NPCs
--    always defend.
--  - A die hits on 6, never on 1, otherwise when roll + computers - target shields >= 6.
--  - A ship is destroyed when its damage is greater than its hull.
--  - Player ships without cannons (missile boats) escape after the missile volley.
--    Starbases never escape. Escaped ships count as survivors if their side wins. If both
--    sides end up with only escaped ships, it's a draw.
--  - NPCs hit the biggest ship they can destroy, else the biggest ship (size order:
--    interceptor, cruiser, starbase, dreadnought). Players destroy what they can, the most
--    damaged first. Morph Shield repairs 1 damage at the end of each engagement round.
--  - Rift cannons roll the rift die (CombatSim_RIFT_FACES): miss, 1 damage, 2 damage,
--    3 damage + 1 self damage, 1 self damage, miss. Its hits ignore computers and shields.
--    Self damage goes to the shooter's own ships with rift weapons: destroying the largest
--    ship it can (largest to smallest), else on the largest.
--  - A battle still going after CombatSim_MAX_ROUNDS rounds is a draw.
--  - Not simulated: retreating (other than missile boats).

local CombatSim_RUN_CHOICES = { 1000, 5000 }  -- the battles per simulation the panel offers
local CombatSim_PER_FRAME = 50      -- battles per frame, so the game doesn't freeze
local CombatSim_MAX_ROUNDS = 100    -- a battle still going after this many rounds is a draw
-- position of the button on the player board (board-local). Buttons aren't mirrored like
-- the snap points: negative x is the board's left side, seen from the owner's seat.
local CombatSim_BUTTON_POSITION = {-2.0, 0.09, -0.8}
-- panel heights (Global.-1.xml): against an NPC, and with the other player's ships shown
local CombatSim_HEIGHT_NPC = 540
local CombatSim_HEIGHT_PLAYER = 700
local CombatSim_LIST_SIZE = 6  -- option buttons after "Ancients" (CombatSim_Option1..6)

-- size: the order NPCs (and rift self damage) pick targets in, biggest first
local CombatSim_SHIPS = {
  { ship = "interceptor", label = "Interceptors", max = 8, size = 1 },
  { ship = "cruiser",     label = "Cruisers",     max = 4, size = 2 },
  { ship = "dreadnought", label = "Dreadnoughts", max = 2, size = 4 },
  { ship = "starbase",    label = "Starbases",    max = 4, size = 3 },
}
local CombatSim_SIDES = { "you", "opp" }
local CombatSim_PLAIN = { ancient = "Ancient", guardian = "Guardian", gcds = "GCDS" }
-- the players in the opponent list, in seat order (clockwise)
local CombatSim_COLOR_ORDER = { "Yellow", "Red", "Green", "Blue", "Purple", "White" }
-- the rift die: damage to the target and damage to your own ships, per face
local CombatSim_RIFT_FACES = {
  { hit = 0, self = 0 }, { hit = 1, self = 0 }, { hit = 2, self = 0 },
  { hit = 3, self = 1 }, { hit = 0, self = 1 }, { hit = 0, self = 0 },
}

CombatSim_owner = nil      -- color whose ships are simulated ("you")
CombatSim_viewer = nil     -- color the panel is shown to
CombatSim_opponent = "npc" -- "npc" (Ancients, GCDS, Guardian) or a player color
CombatSim_listColors = {}  -- the color of each player option in the opponent list
CombatSim_attacking = true -- against a player: whether "you" attack (the opponent defends)
CombatSim_counts = nil     -- { you = { ship = count }, opp = { ship = count } }
CombatSim_job = nil        -- the simulation running now
CombatSim_runs = 1000      -- battles per simulation (chosen in the panel)
CombatSim_lastResult = nil

local function CombatSim_noShips()
  local counts = {}
  for _, entry in ipairs(CombatSim_SHIPS) do counts[entry.ship] = 0 end
  return counts
end
CombatSim_counts = { you = CombatSim_noShips(), opp = CombatSim_noShips() }

--------------------------------------------------------------------------------
-- the button on the player boards

function CombatSim_addButton(board)
  if board == nil then return end
  for _, button in ipairs(board.getButtons() or {}) do
    if button.click_function == "CombatSim_open" then return end
  end
  board.createButton({
    click_function = "CombatSim_open",
    function_owner = self,
    label = "Combat Sim",
    tooltip = "Simulate a battle of your ships against NPCs or another player",
    position = CombatSim_BUTTON_POSITION,
    scale = {0.3, 0.3, 0.3},
    width = 700,
    height = 220,
    font_size = 110,
    color = {0.7573, 0.7573, 0.7573, 1},
  })
end

-- called by onLoad: buttons made by scripts aren't saved
function CombatSim_restore()
  for color, _ in pairs(PlayerState) do CombatSim_addButton(PlayerState_board(color)) end
end

function CombatSim_ownerOf(board)
  for color, _ in pairs(PlayerState) do
    if PlayerState_board(color) == board then return color end
  end
  return nil
end

--------------------------------------------------------------------------------
-- the panel

-- the opponent's player color, or nil when the opponent is an NPC
function CombatSim_opponentColor()
  if CombatSim_opponent ~= "npc" then return CombatSim_opponent end
  return nil
end

-- players who can be picked as the opponent: everyone with a faction but the owner
function CombatSim_opponents()
  local colors = {}
  for _, color in ipairs(CombatSim_COLOR_ORDER) do
    if color ~= CombatSim_owner and PlayerState_faction(color) ~= nil then table.insert(colors, color) end
  end
  return colors
end

-- the color whose ships a side has ("you" or "opp"), or nil
function CombatSim_sideColor(side)
  if side == "you" then return CombatSim_owner end
  return CombatSim_opponentColor()
end

function CombatSim_open(board, playerColor)
  local owner = CombatSim_ownerOf(board)
  if owner == nil then
    broadcastToColor("Combat Sim: nobody has this player board yet.", playerColor, {1, 0.4, 0.4})
    return
  end
  if owner ~= CombatSim_owner then
    CombatSim_counts.you = CombatSim_noShips()
    CombatSim_lastResult = nil
  end
  CombatSim_owner = owner
  CombatSim_viewer = playerColor
  -- the opponent can't be the owner, and must still be playing
  local oppColor = CombatSim_opponentColor()
  if oppColor ~= nil and (oppColor == owner or PlayerState_faction(oppColor) == nil) then
    CombatSim_setOpponent("npc")
  end
  CombatSim_listOpen = false
  UI.setAttribute("CombatSim_List", "active", "false")
  UI.setAttribute("CombatSim_Panel", "visibility", playerColor)
  UI.setAttribute("CombatSim_Panel", "active", "true")
  CombatSim_updateUI()
end

function CombatSim_close(player)
  UI.setAttribute("CombatSim_Panel", "active", "false")
end

-- onClick of the "1k" / "5k" buttons
function CombatSim_setRuns(player, value)
  local runs = tonumber(value)
  for _, choice in ipairs(CombatSim_RUN_CHOICES) do
    if choice == runs then CombatSim_runs = runs end
  end
  CombatSim_updateUI()
end

function CombatSim_setOpponent(opponent)
  if opponent ~= CombatSim_opponent then
    CombatSim_counts.opp = CombatSim_noShips()
    CombatSim_lastResult = nil
  end
  CombatSim_opponent = opponent
end

CombatSim_listOpen = false

-- onClick of the dropdown button: open or close the option list
function CombatSim_toggleList(player)
  CombatSim_listColors = CombatSim_opponents()
  for i = 1, CombatSim_LIST_SIZE do
    local color = CombatSim_listColors[i]
    UI.setAttribute("CombatSim_Option" .. i, "active", color and "true" or "false")
    if color ~= nil then
      UI.setAttribute("CombatSim_Option" .. i, "text", CombatSim_playerText(color))
      UI.setAttribute("CombatSim_Option" .. i, "textColor", CombatSim_colorHex(color))
    end
  end
  UI.setAttribute("CombatSim_List", "height", 28 * (1 + #CombatSim_listColors) + 4)
  CombatSim_listOpen = not CombatSim_listOpen
  UI.setAttribute("CombatSim_List", "active", CombatSim_listOpen and "true" or "false")
end

-- onClick of an option: 0 is Ancients, 1.. the players in CombatSim_listColors
function CombatSim_pick(player, value)
  local index = tonumber(value) or 0
  CombatSim_setOpponent(index == 0 and "npc" or (CombatSim_listColors[index] or "npc"))
  CombatSim_listOpen = false
  UI.setAttribute("CombatSim_List", "active", "false")
  CombatSim_updateUI()
end

-- onClick of the "Attacking" / "Defending" buttons
function CombatSim_setRole(player, value)
  CombatSim_attacking = value ~= "defend"
  CombatSim_updateUI()
end

-- onClick of the -/+ buttons: "interceptor" (your ships) or "opp_interceptor"
function CombatSim_plus(player, value) CombatSim_change(value, 1) end
function CombatSim_minus(player, value) CombatSim_change(value, -1) end

function CombatSim_change(value, delta)
  local side, ship = "you", value
  local oppShip = string.match(value or "", "^opp_(%a+)$")
  if oppShip ~= nil then side, ship = "opp", oppShip end
  for _, entry in ipairs(CombatSim_SHIPS) do
    if entry.ship == ship then
      local count = (CombatSim_counts[side][ship] or 0) + delta
      if CombatSim_shipStats(side, ship) == nil then count = 0 end
      CombatSim_counts[side][ship] = math.max(0, math.min(entry.max, count))
    end
  end
  CombatSim_updateUI()
end

-- a side's blueprint stats for a ship type, or nil (e.g. Rho Indi has no dreadnought)
function CombatSim_shipStats(side, ship)
  local color = CombatSim_sideColor(side)
  if color == nil or PlayerState_faction(color) == nil then return nil end
  return ShipState_stats(color, ship)
end

-- the Exiles have Orbitals in place of Starbases
function CombatSim_label(side, entry)
  local color = CombatSim_sideColor(side)
  local faction = color and PlayerState_faction(color) or ""
  if entry.ship == "starbase" and string.find(faction, "Exiles") then return "Orbitals" end
  return entry.label
end

local function CombatSim_diceText(list, suffix)
  local parts = {}
  for _, die in ipairs(list or {}) do
    table.insert(parts, string.format("%d %s%s", die.count, die.color, suffix))
  end
  return parts
end

-- "Init 3, 2 yellow, +1 comp, shield 1, hull 2"
function CombatSim_statLine(stats)
  local parts = { "Init " .. stats.initiative }
  for _, text in ipairs(CombatSim_diceText(stats.missiles, " missile")) do table.insert(parts, text) end
  for _, text in ipairs(CombatSim_diceText(stats.cannons, "")) do table.insert(parts, text) end
  if stats.computer > 0 then table.insert(parts, "+" .. stats.computer .. " comp") end
  if stats.shield > 0 then table.insert(parts, "shield " .. stats.shield) end
  table.insert(parts, "hull " .. stats.hull)
  return table.concat(parts, ", ")
end

-- a player color as "#rrggbb", for UI text
function CombatSim_colorHex(color)
  local ok, hex = pcall(function() return Color.fromString(color):toHex(false) end)
  if ok and type(hex) == "string" then return "#" .. hex end
  return "#FFFFFF"
end

-- "Alice (Hydran Progress)"
function CombatSim_playerText(color)
  local faction = PlayerState_faction(color)
  if faction == nil then return color .. ": nobody has this color" end
  return ATO_name(color) .. " (" .. faction .. ")"
end

function CombatSim_updateUI()
  UI.setValue("CombatSim_Owner", CombatSim_playerText(CombatSim_owner))
  local oppColor = CombatSim_opponentColor()
  for _, side in ipairs(CombatSim_SIDES) do
    local prefix = side == "you" and "CombatSim_" or "CombatSim_opp_"
    for _, entry in ipairs(CombatSim_SHIPS) do
      local stats = CombatSim_shipStats(side, entry.ship)
      if stats == nil then CombatSim_counts[side][entry.ship] = 0 end
      UI.setValue(prefix .. entry.ship .. "_Label", CombatSim_label(side, entry))
      UI.setValue(prefix .. entry.ship .. "_Count", tostring(CombatSim_counts[side][entry.ship]))
      UI.setValue(prefix .. entry.ship .. "_Info", stats and CombatSim_statLine(stats) or "(none)")
    end
  end

  local vsPlayer = oppColor ~= nil
  UI.setAttribute("CombatSim_Opponent", "text", (vsPlayer and CombatSim_playerText(oppColor) or "Ancients") .. "  ▼")
  UI.setAttribute("CombatSim_Opponent", "textColor", vsPlayer and CombatSim_colorHex(oppColor) or "#FFFFFF")
  UI.setAttribute("CombatSim_OppShips", "active", vsPlayer and "true" or "false")
  UI.setAttribute("CombatSim_Simulate", "active", vsPlayer and "true" or "false")
  UI.setAttribute("CombatSim_NpcButtons", "active", vsPlayer and "false" or "true")
  UI.setAttribute("CombatSim_Guardian", "active", CombatSim_npcVariant("guardian") and "true" or "false")
  UI.setAttribute("CombatSim_Panel", "height", vsPlayer and CombatSim_HEIGHT_PLAYER or CombatSim_HEIGHT_NPC)
  -- NPCs always defend
  local attacking = CombatSim_attacking or not vsPlayer
  UI.setAttribute("CombatSim_Attack", "color", attacking and "#9fd59f" or "#d0d0d0")
  UI.setAttribute("CombatSim_Defend", "color", attacking and "#d0d0d0" or "#9fd59f")
  UI.setAttribute("CombatSim_Defend", "interactable", vsPlayer and "true" or "false")

  for _, choice in ipairs(CombatSim_RUN_CHOICES) do
    UI.setAttribute("CombatSim_Runs" .. choice, "color", choice == CombatSim_runs and "#9fd59f" or "#d0d0d0")
  end
  if CombatSim_job == nil then
    UI.setValue("CombatSim_Result", CombatSim_lastResult or "Set your ships and pick an opponent.")
  end
end

--------------------------------------------------------------------------------
-- the NPC variants in this game

-- the variant of an NPC type on the table, or nil if there is none. The miniature setup
-- put out wins over the stock bag the sector ancients come from.
function CombatSim_npcVariant(npc)
  local onTable, inBags = {}, {}
  for _, obj in ipairs(getAllObjects()) do
    local variant = ShipState_npcOf(obj)
    if variant ~= nil and NPC_SHIPS[variant].npc == npc then
      if obj.type == "Infinite" then inBags[variant] = true else onTable[variant] = true end
    end
  end
  for _, found in ipairs({ onTable, inBags }) do
    local pick = nil
    for variant, _ in pairs(found) do
      if pick == nil or pick == CombatSim_PLAIN[npc] then pick = variant end
    end
    if pick ~= nil then return pick end
  end
  return nil
end

--------------------------------------------------------------------------------
-- the simulation

local function CombatSim_dice(list)
  local damages = {}
  for _, die in ipairs(list or {}) do
    if not die.rift then
      for _ = 1, die.count do table.insert(damages, die.damage or 1) end
    end
  end
  return damages
end

local function CombatSim_riftDice(list)
  local count = 0
  for _, die in ipairs(list or {}) do
    if die.rift then count = count + die.count end
  end
  return count
end

-- side: "you" or "opp". npc: NPC ships pick targets by size and never escape.
function CombatSim_template(stats, side, ship, size, npc)
  local cannons = CombatSim_dice(stats.cannons)
  local rift = CombatSim_riftDice(stats.cannons)
  return {
    side = side, ship = ship, size = size, npc = npc == true,
    initiative = stats.initiative, computer = stats.computer, shield = stats.shield,
    hp = stats.hull + 1,
    cannons = cannons, missiles = CombatSim_dice(stats.missiles), rift = rift,
    regenerate = stats.regenerate == true,
    escapes = not npc and ship ~= "starbase" and #cannons == 0 and rift == 0,
  }
end

-- a hit from the rift die (auto) always hits
function CombatSim_canHit(hit, computer, target)
  if hit.auto then return true end
  local roll = hit.roll
  if roll == 6 then return true end
  if roll == 1 then return false end
  return roll + computer - target.tpl.shield >= 6
end

local function CombatSim_damage(target, amount)
  target.dmg = target.dmg + amount
  if target.dmg >= target.tpl.hp then target.alive = false end
end

-- assign one ship's hits to ships (the enemy's, or its own for rift self damage).
-- bySize: aim at the biggest ships first (NPCs, and rift self damage)
function CombatSim_assign(hits, computer, enemies, bySize)
  local targets = {}
  for _, ship in ipairs(enemies) do
    if ship.alive and not ship.gone then table.insert(targets, ship) end
  end
  if #targets == 0 then return end

  -- biggest ships first if bySize; both sides prefer ships that are already damaged
  table.sort(targets, function(a, b)
    if bySize and a.tpl.size ~= b.tpl.size then return a.tpl.size > b.tpl.size end
    return a.dmg > b.dmg
  end)
  table.sort(hits, function(a, b) return a.dmg > b.dmg end)

  -- 1. destroy what can be destroyed, in target order
  local used = {}
  for _, target in ipairs(targets) do
    local need = target.tpl.hp - target.dmg
    -- the smallest single hit that destroys it
    local single = nil
    for i, hit in ipairs(hits) do
      if not used[i] and hit.dmg >= need and CombatSim_canHit(hit, computer, target) then single = i end
    end
    if single ~= nil then
      used[single] = true
      CombatSim_damage(target, hits[single].dmg)
    else
      -- else the biggest hits until it is destroyed
      local pick, total = {}, 0
      for i, hit in ipairs(hits) do
        if total < need and not used[i] and CombatSim_canHit(hit, computer, target) then
          table.insert(pick, i)
          total = total + hit.dmg
        end
      end
      if total >= need then
        for _, i in ipairs(pick) do used[i] = true end
        CombatSim_damage(target, total)
      end
    end
  end

  -- 2. the rest goes on the first ship each hit can reach
  for i, hit in ipairs(hits) do
    if not used[i] then
      for _, target in ipairs(targets) do
        if target.alive and CombatSim_canHit(hit, computer, target) then
          CombatSim_damage(target, hit.dmg)
          break
        end
      end
    end
  end
end

-- one battle. groups: { {tpl, count} } in firing order.
-- Returns "win", "loss" or "draw" (for "you"), and both sides' ships.
function CombatSim_battle(groups)
  local sides = { you = {}, opp = {} }
  local order = {}
  for _, group in ipairs(groups) do
    local members = {}
    for _ = 1, group.count do
      local ship = { tpl = group.tpl, dmg = 0, alive = true, gone = false }
      table.insert(members, ship)
      table.insert(sides[group.tpl.side], ship)
    end
    table.insert(order, { tpl = group.tpl, members = members })
  end

  -- ships still fighting (alive and not escaped), and ships alive at all
  local function count(side)
    local standing, alive = 0, 0
    for _, ship in ipairs(sides[side]) do
      if ship.alive then
        alive = alive + 1
        if not ship.gone then standing = standing + 1 end
      end
    end
    return standing, alive
  end

  -- own ships with rift weapons: they take the rift die's self damage
  local riftShips = { you = {}, opp = {} }
  for side, ships in pairs(sides) do
    for _, ship in ipairs(ships) do
      if ship.tpl.rift > 0 then table.insert(riftShips[side], ship) end
    end
  end

  local function volley(kind)
    for _, group in ipairs(order) do
      local tpl = group.tpl
      local dice = tpl[kind]
      local rift = kind == "cannons" and tpl.rift or 0
      if #dice > 0 or rift > 0 then
        local enemies = sides[tpl.side == "you" and "opp" or "you"]
        for _, ship in ipairs(group.members) do
          if ship.alive and not ship.gone then
            local hits, selfHits = {}, {}
            for _, damage in ipairs(dice) do
              table.insert(hits, { roll = math.random(6), dmg = damage })
            end
            for _ = 1, rift do
              local face = CombatSim_RIFT_FACES[math.random(6)]
              if face.hit > 0 then table.insert(hits, { auto = true, dmg = face.hit }) end
              if face.self > 0 then table.insert(selfHits, { auto = true, dmg = face.self }) end
            end
            CombatSim_assign(hits, tpl.computer, enemies, tpl.npc)
            if #selfHits > 0 then CombatSim_assign(selfHits, 0, riftShips[tpl.side], true) end
          end
        end
      end
    end
  end

  volley("missiles")
  -- missile boats leave once they have fired
  for _, ships in pairs(sides) do
    for _, ship in ipairs(ships) do
      if ship.alive and ship.tpl.escapes then ship.gone = true end
    end
  end

  local rounds = 0
  while count("you") > 0 and count("opp") > 0 and rounds < CombatSim_MAX_ROUNDS do
    rounds = rounds + 1
    volley("cannons")
    -- Morph Shield: repair 1 damage at the end of each engagement round
    for _, ships in pairs(sides) do
      for _, ship in ipairs(ships) do
        if ship.alive and ship.tpl.regenerate and ship.dmg > 0 then ship.dmg = ship.dmg - 1 end
      end
    end
  end

  local youStanding, youAlive = count("you")
  local oppStanding, oppAlive = count("opp")
  local outcome = "draw"
  if oppStanding == 0 and youStanding > 0 then outcome = "win"
  elseif youStanding == 0 and oppStanding > 0 then outcome = "loss"
  elseif youStanding == 0 and oppStanding == 0 then
    -- nobody is left fighting: whoever still has ships (escaped) wins
    if oppAlive == 0 and youAlive > 0 then outcome = "win"
    elseif youAlive == 0 and oppAlive > 0 then outcome = "loss" end
  end
  return outcome, sides
end

-- a side's ship groups from the panel counts; nil if it has none
local function CombatSim_fleet(side, groups, notes, who)
  local fleet, total = {}, 0
  for _, entry in ipairs(CombatSim_SHIPS) do
    local count = CombatSim_counts[side][entry.ship] or 0
    local stats = CombatSim_shipStats(side, entry.ship)
    if count > 0 and stats ~= nil then
      local tpl = CombatSim_template(stats, side, entry.ship, entry.size, false)
      table.insert(groups, { tpl = tpl, count = count })
      fleet[entry.ship] = count
      total = total + count
      if tpl.escapes then
        table.insert(notes, who .. " " .. CombatSim_label(side, entry) ..
          " have no cannons: they escape after the missiles.")
      end
    end
  end
  if total == 0 then return nil end
  return fleet
end

-- onClick of the NPC buttons: "ancient", "ancient2" (two Ancients), "gcds", "guardian"
function CombatSim_simulate(player, value)
  CombatSim_start(value)
end

-- onClick of the Simulate button (against the player picked as the opponent)
function CombatSim_simulatePlayer(player)
  if CombatSim_opponentColor() ~= nil then CombatSim_start(nil) end
end

-- npcChoice: the NPC to fight, or nil to fight the opponent player
function CombatSim_start(npcChoice)
  if CombatSim_job ~= nil then return end
  local groups, notes = {}, {}
  local fleets = {}
  fleets.you = CombatSim_fleet("you", groups, notes, "Your")
  if fleets.you == nil then
    UI.setValue("CombatSim_Result", "Add at least one of your ships.")
    return
  end

  local oppColor = npcChoice == nil and CombatSim_opponentColor() or nil
  local title, npcLine, defender
  if npcChoice == nil then
    if oppColor == nil then return end
    if oppColor == CombatSim_owner then
      UI.setValue("CombatSim_Result", "Pick another player as the opponent.")
      return
    end
    if PlayerState_faction(oppColor) == nil then
      UI.setValue("CombatSim_Result", "Nobody has the color " .. oppColor .. ".")
      return
    end
    fleets.opp = CombatSim_fleet("opp", groups, notes, ATO_name(oppColor) .. "'s")
    if fleets.opp == nil then
      UI.setValue("CombatSim_Result", "Add at least one ship for " .. ATO_name(oppColor) .. ".")
      return
    end
    defender = CombatSim_attacking and "opp" or "you"
    title = (CombatSim_attacking and "Attacking " or "Defending against ") .. ATO_name(oppColor)
  else
    local npc = npcChoice == "ancient2" and "ancient" or npcChoice
    local npcCount = npcChoice == "ancient2" and 2 or 1
    if npc ~= "ancient" and npc ~= "gcds" and npc ~= "guardian" then return end
    local variant = CombatSim_npcVariant(npc) or (npc ~= "guardian" and CombatSim_PLAIN[npc]) or nil
    if variant == nil then
      UI.setValue("CombatSim_Result", "There is no Guardian in this game.")
      return
    end
    local npcStats = ShipState_npcStats(variant)
    table.insert(groups, { tpl = CombatSim_template(npcStats, "opp", "npc", 0, true), count = npcCount })
    defender = "opp"
    title = "vs " .. (npcCount == 2 and "2 x " or "") .. variant
    npcLine = CombatSim_statLine(npcStats)
  end

  -- firing order: initiative, the defender first on a tie
  table.sort(groups, function(a, b)
    if a.tpl.initiative ~= b.tpl.initiative then return a.tpl.initiative > b.tpl.initiative end
    return a.tpl.side == defender and b.tpl.side ~= defender
  end)

  CombatSim_job = {
    groups = groups, fleets = fleets, notes = notes, runs = CombatSim_runs,
    done = 0, outcomes = { win = 0, loss = 0, draw = 0 },
    survivors = { you = CombatSim_noShips(), opp = CombatSim_noShips() },
    title = title, npcLine = npcLine, oppColor = oppColor,
  }
  UI.setValue("CombatSim_Result", "Simulating...")
  startLuaCoroutine(self, "CombatSim_run")
end

-- runs as a coroutine: CombatSim_PER_FRAME battles per frame
function CombatSim_run()
  local job = CombatSim_job
  while job.done < job.runs do
    for _ = 1, CombatSim_PER_FRAME do
      if job.done >= job.runs then break end
      job.done = job.done + 1
      local outcome, sides = CombatSim_battle(job.groups)
      job.outcomes[outcome] = job.outcomes[outcome] + 1
      -- the winner's surviving ships
      local winner = (outcome == "win" and "you") or (outcome == "loss" and "opp") or nil
      if winner ~= nil and job.fleets[winner] ~= nil then
        for _, ship in ipairs(sides[winner]) do
          if ship.alive then
            job.survivors[winner][ship.tpl.ship] = job.survivors[winner][ship.tpl.ship] + 1
          end
        end
      end
    end
    UI.setValue("CombatSim_Result", string.format("Simulating... %d / %d", job.done, job.runs))
    coroutine.yield(0)
  end
  CombatSim_job = nil
  CombatSim_showResult(job)
  return 1
end

local function CombatSim_percent(count, runs) return 100 * count / runs end

function CombatSim_showResult(job)
  local o = job.outcomes
  local header = "<b>" .. job.title .. "</b>"
  if job.npcLine ~= nil then header = header .. "  (" .. job.npcLine .. ")" end
  local odds = string.format("<b>Win: %.1f %%</b>   Loss: %.1f %%", CombatSim_percent(o.win, job.runs),
    CombatSim_percent(o.loss, job.runs))
  if o.draw > 0 then odds = odds .. string.format("   Draw: %.1f %%", CombatSim_percent(o.draw, job.runs)) end
  local lines = { header, odds .. string.format("  (%d battles)", job.runs) }

  local function survivors(side, wins, heading)
    if wins == 0 or job.fleets[side] == nil then return end
    local parts = {}
    for _, entry in ipairs(CombatSim_SHIPS) do
      local count = job.fleets[side][entry.ship]
      if count ~= nil then
        table.insert(parts, string.format("%s %.2f of %d", CombatSim_label(side, entry),
          job.survivors[side][entry.ship] / wins, count))
      end
    end
    table.insert(lines, heading)
    table.insert(lines, "  " .. table.concat(parts, ", "))
  end
  survivors("you", o.win, "Your surviving ships when you win (average):")
  if job.oppColor ~= nil then
    survivors("opp", o.loss, ATO_name(job.oppColor) .. "'s surviving ships when they win (average):")
  end
  for _, note in ipairs(job.notes) do table.insert(lines, "<i>" .. note .. "</i>") end
  CombatSim_lastResult = table.concat(lines, "\n")
  UI.setValue("CombatSim_Result", CombatSim_lastResult)
end
